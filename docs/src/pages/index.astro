---
import BaseLayout from "../layouts/BaseLayout.astro";
import Banner from "../components/feature/Banner.astro";
import VideoFigure from "../components/feature/VideoFigure.astro";
import SiteFooter from "../components/feature/SiteFooter.astro";
import Link from "../components/ui/Link.astro";
import { site } from "../config/site";

const videos = [
	{
		id: "v1792853147/IMG_7058-lowered-m_iwxxjm",
		width: 270,
		height: 480,
		alt: "opencode going from idle to working to permission and back, with the LED following",
		caption: "An agent goes from idle to working to waiting for permission, and the LED follows."
	},
	{
		id: "v1792853141/IMG_7045-lowered-m_xkpl6m",
		width: 720,
		height: 405,
		alt: "opencode asks for permission on the Mac, and the board shows it on top with the LED turning red",
		caption: "The agent that waits for you comes to the top."
	},
	{
		id: "v1792853143/IMG_7075-lowered-m_sphvxd",
		width: 720,
		height: 405,
		alt: "Tapping rows on the board, and the Rex app on the monitor behind it switching to each one's pane, including one on another server",
		caption: "Tap a row and Rex brings its pane to the front, even on another server."
	}
];

const [cycle, permission, tap] = videos;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareSourceCode",
	name: site.name,
	description: site.description,
	url: site.url,
	codeRepository: site.links.repo,
	license: site.links.licence,
	programmingLanguage: ["C++", "Lua"]
};

const navLink =
	"text-muted-foreground underline decoration-border decoration-2 underline-offset-3 transition-colors hover:text-foreground hover:decoration-primary";
---

<BaseLayout>
	<script slot='head' type='application/ld+json' is:inline set:html={JSON.stringify(jsonLd)} />

	<main class='mx-auto max-w-page px-4 pt-12'>
		<header class='flex flex-wrap items-start justify-between gap-x-8 gap-y-4'>
			<Banner class='w-60' />

			<nav class='ml-auto flex items-center gap-6 text-sm' aria-label='Site'>
				<a class={navLink} href='/docs/'>Docs</a>
				<a class={navLink} href='/install/'>Install</a>
				<a class={navLink} href={site.links.repo}>GitHub</a>
			</nav>
		</header>

		<p class='mt-10 max-w-xl text-xl leading-[1.4]'>
			A cheap <Link href={site.links.rex}>Rex</Link> display for coding agents. It shows the agents running in your Rex sessions
			on a Cheap Yellow Display, and its LED tells you when one waits for you.
		</p>

		<div class='mt-9 grid grid-cols-1 items-start gap-3 sm:grid-cols-[0.633fr_1fr]'>
			<VideoFigure {...cycle} class='mx-auto w-full max-w-60 sm:mx-0 sm:max-w-none' />

			<div class='flex min-w-0 flex-col gap-3'>
				<VideoFigure {...permission} />
				<VideoFigure {...tap} />
			</div>
		</div>
	</main>

	<SiteFooter />
</BaseLayout>
