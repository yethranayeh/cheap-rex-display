---
import { mediaSrc } from "../../config/site";

interface Props {
	/** Cloudinary public id */
	id: string;
	width: number;
	height: number;
	alt: string;
	caption: string;
	class?: string;
}

const { id, width, height, alt, caption, class: className } = Astro.props;
---

<figure class:list={["min-w-0", className]}>
	{/* The uploads are HEVC, so vc_h264 is used for browser compatibility */}
	<video
		class='block h-auto w-full rounded-lg border border-border bg-ink'
		src={mediaSrc(`vc_h264/${id}.mp4`, "video")}
		poster={mediaSrc(`so_0/${id}.jpg`, "video")}
		width={width}
		height={height}
		autoplay
		muted
		loop
		playsinline
		aria-label={alt}></video>
	<figcaption class='mt-2.5 text-sm leading-normal text-muted-foreground'>{caption}</figcaption>
</figure>
