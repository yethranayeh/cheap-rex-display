---
import banner from "../../../../assets/branding/banner.svg?raw";
import { site } from "../../config/site";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<h1
	class:list={["text-foreground [&_svg]:block [&_svg]:h-auto [&_svg]:w-full", className]}
	aria-label={site.name}
	set:html={banner}
/>
