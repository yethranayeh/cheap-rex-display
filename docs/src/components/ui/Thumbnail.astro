---
import PreviewCard from "./PreviewCard.astro";

interface Props {
	src: string;
	alt: string;
	width: number;
	height: number;
	/** Accessible name for the thumbnail button */
	label: string;
	/** Short heading in the expanded card */
	title: string;
	/** Caption under the expanded image */
	caption: string;
	class?: string;
}

const { src, alt, width, height, label, title, caption, class: className } = Astro.props;
const id = `thumb-${crypto.randomUUID()}`;
---

<span
	class:list={[
		"inline-thumb group/preview absolute top-[0.05rem] left-[calc(100%+2rem)] block h-11 w-[4.25rem] max-lg:static max-lg:mt-2.5 max-lg:h-auto max-lg:w-auto",
		className
	]}
	data-preview-root
	data-preview-pinned
	data-thumb>
	<button
		class='inline-thumb-button block h-11 w-[4.25rem] cursor-zoom-in overflow-hidden rounded-sm border-2 border-lavender/45 bg-ink p-0 transition-colors duration-150 hover:border-lavender focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ring aria-expanded:border-lavender max-lg:hidden motion-reduce:transition-none'
		type='button'
		aria-label={label}
		aria-expanded='false'
		aria-controls={id}
		data-preview-trigger>
		<img
			class='block size-full object-cover'
			src={src}
			alt=''
			width={width}
			height={height}
			loading='lazy'
			decoding='async'
		/>
	</button>

	<PreviewCard
		id={id}
		role='figure'
		accent='lavender'
		kicker='Preview'
		title={title}
		image={{ src, alt, width, height }}
		caption={caption}
		label={label}
		class='inline-thumb-card max-lg:static max-lg:grid max-lg:w-full max-lg:max-h-none max-lg:grid-cols-[12rem_minmax(0,1fr)] max-lg:items-start max-lg:overflow-hidden max-lg:p-0 max-lg:border max-lg:border-border max-lg:border-t-2 max-lg:border-t-lavender/50 max-lg:rounded-sm max-lg:bg-surface max-lg:opacity-100 max-lg:shadow-none max-lg:visible max-lg:pointer-events-auto max-lg:translate-y-0 max-lg:scale-100 max-sm:grid-cols-1'
		headClass='inline-thumb-head max-lg:hidden'
		imageClass='inline-thumb-image max-lg:h-full max-lg:border-0 max-lg:border-r max-lg:border-border max-lg:rounded-none max-lg:object-cover max-sm:h-auto max-sm:border-r-0 max-sm:border-b'
		captionClass='inline-thumb-caption max-lg:m-0 max-lg:flex max-lg:items-center max-lg:px-[0.7rem] max-lg:py-[0.6rem]'
	/>
</span>
