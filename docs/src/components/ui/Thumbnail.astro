---
import PreviewCard from "./PreviewCard.astro";

interface Props {
	src: string;
	alt: string;
	width: number;
	height: number;
	/** Accessible name for the thumbnail button */
	label: string;
	/** Short heading in the expanded card */
	title: string;
	/** Caption under the expanded image */
	caption: string;
	class?: string;
}

const { src, alt, width, height, label, title, caption, class: className } = Astro.props;
const id = `thumb-${crypto.randomUUID()}`;
---

<span
	class:list={[
		"inline-thumb group/preview absolute top-[0.05rem] left-[calc(100%+2rem)] block h-11 w-[4.25rem] max-[959px]:static max-[959px]:mt-2.5 max-[959px]:h-auto max-[959px]:w-auto",
		className
	]}
	data-preview-root
	data-preview-pinned
	data-thumb>
	<button
		class='inline-thumb-button block h-11 w-[4.25rem] cursor-zoom-in overflow-hidden rounded-sm border-2 border-lavender/45 bg-ink p-0 transition-colors duration-150 hover:border-lavender focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ring aria-expanded:border-lavender max-[959px]:hidden motion-reduce:transition-none'
		type='button'
		aria-label={label}
		aria-expanded='false'
		aria-controls={id}
		data-preview-trigger>
		<img
			class='block size-full object-cover'
			src={src}
			alt=''
			width={width}
			height={height}
			loading='lazy'
			decoding='async'
		/>
	</button>

	<PreviewCard
		id={id}
		role='figure'
		accent='lavender'
		kicker='Preview'
		title={title}
		image={{ src, alt, width, height }}
		caption={caption}
		label={label}
		class='inline-thumb-card max-[959px]:static max-[959px]:grid max-[959px]:w-full max-[959px]:max-h-none max-[959px]:grid-cols-[12rem_minmax(0,1fr)] max-[959px]:items-start max-[959px]:overflow-hidden max-[959px]:p-0 max-[959px]:border max-[959px]:border-border max-[959px]:border-t-2 max-[959px]:border-t-lavender/50 max-[959px]:rounded-sm max-[959px]:bg-surface max-[959px]:opacity-100 max-[959px]:shadow-none max-[959px]:visible max-[959px]:pointer-events-auto max-[959px]:translate-y-0 max-[959px]:scale-100 max-[479px]:grid-cols-1'
		headClass='inline-thumb-head max-[959px]:hidden'
		imageClass='inline-thumb-image max-[959px]:h-full max-[959px]:border-0 max-[959px]:border-r max-[959px]:border-border max-[959px]:rounded-none max-[959px]:object-cover max-[479px]:h-auto max-[479px]:border-r-0 max-[479px]:border-b'
		captionClass='inline-thumb-caption max-[959px]:m-0 max-[959px]:flex max-[959px]:items-center max-[959px]:px-[0.7rem] max-[959px]:py-[0.6rem]'
	/>
</span>
