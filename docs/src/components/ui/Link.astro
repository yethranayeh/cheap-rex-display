---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
	/** Marks a link that leaves the site with arrrow for cases that mgiht be misleading */
	offsite?: boolean;
};

const { class: className, offsite = false, ...rest } = Astro.props;
---

<a
	class:list={[
		"text-primary underline decoration-2 underline-offset-3 hover:text-foreground hover:decoration-primary",
		className
	]}
	{...rest}><slot />{offsite && <span aria-hidden='true'> ↗</span>}</a
>
