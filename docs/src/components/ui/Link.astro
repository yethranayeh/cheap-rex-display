---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className, ...rest } = Astro.props;
---

<a
	class:list={[
		"text-primary underline decoration-2 underline-offset-3 hover:text-foreground hover:decoration-primary",
		className
	]}
	{...rest}><slot /></a
>
